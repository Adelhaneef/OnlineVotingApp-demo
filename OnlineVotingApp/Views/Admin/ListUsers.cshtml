@model List<Microsoft.AspNetCore.Identity.IdentityUser>

@{
    ViewData["Title"] = "All Registered Users";
}

<h2 class="text-primary mb-4">👥 All Registered Users</h2>

<!-- ✅ Show error or success message from TempData -->
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-bordered table-striped shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Email</th>
            <th>User ID</th>
            <th>Actions</th> <!-- ✅ New column for delete button -->
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>@user.Id</td>
                <td>
                    <!-- ✅ Form with POST button to delete the user -->
                    <form asp-controller="Admin" asp-action="DeleteUser" method="post" onsubmit="return confirm('Are you sure you want to delete this user?');">
                        <input type="hidden" name="id" value="@user.Id" />
                        <button type="submit" class="btn btn-danger btn-sm">🗑️ Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
