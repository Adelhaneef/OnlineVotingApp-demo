@model List<OnlineVotingApp.Models.PollWithUserVote>


@{
    ViewData["Title"] = "Vote on Polls";
}

<h2 class="mb-4">🗳️ Cast Your Vote</h2>

@foreach (var item in Model)
{
    var poll = item.Poll;
    var selectedId = item.SelectedOptionId;
    bool voted = selectedId != null;

    <div class="card mb-3 p-3">
        <h4>@poll.Question</h4>
        <form asp-action="Vote" method="post">
            <input type="hidden" name="PollId" value="@poll.Id" />
            @foreach (var option in poll.AnswerOptions)
            {
                <div class="form-check">
                    <input class="form-check-input"
                           type="radio"
                           name="optionId"
                           value="@option.Id"
                           @(voted ? "disabled" : "")
                           @(selectedId == option.Id ? "checked" : "") />
                    <label class="form-check-label">@option.OptionText</label>
                </div>
            }

            @if (!voted)
            {
                <button type="submit" class="btn btn-success mt-2">Vote</button>
            }
            else
            {
                <p><em>You voted for: @poll.AnswerOptions.First(o => o.Id == selectedId).OptionText</em></p>
            }
        </form>
    </div>
}
