@{
    ViewData["Title"] = "Access Denied";
}

<div class="card border-danger shadow-sm my-5 text-center p-4" style="max-width: 600px; margin: 0 auto;">
    <div class="card-body">
        <h2 class="text-danger mb-3">🚫 Access Denied</h2>
        <p class="text-muted fs-5">
            You do not have permission to access this page or resource.
        </p>
        <div class="mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">Return to Home</a>
        </div>
    </div>
</div>


