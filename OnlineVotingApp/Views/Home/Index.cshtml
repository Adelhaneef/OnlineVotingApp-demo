@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@{
    ViewData["Title"] = "Home";
}

<div class="p-5 mb-4 bg-light rounded-4 shadow-sm text-center">
    <div class="container-fluid py-4">
        <h1 class="display-5 fw-bold text-primary mb-3">🗳️ Online Voting Application</h1>
        <p class="col-md-8 fs-5 mx-auto text-muted">
            A secure, reliable, and transparent platform for digital voting and poll management.
        </p>

        @if (!SignInManager.IsSignedIn(User))
        {
            <div class="mt-4">
                <a href="/Identity/Account/Login" class="btn btn-primary btn-lg px-4 gap-3">🔑 Log In to Vote</a>
            </div>
        }
        else if (User.IsInRole("Admin"))
        {
            <div class="d-flex justify-content-center gap-3 mt-4 flex-wrap">
                <a asp-controller="AdminPolls" asp-action="Index" class="btn btn-primary btn-lg px-4">📊 Manage Polls</a>
                <a asp-controller="AdminPolls" asp-action="Create" class="btn btn-success btn-lg px-4">➕ Create Poll</a>
                <a asp-controller="Admin" asp-action="ListUsers" class="btn btn-outline-secondary btn-lg px-4">👥 Manage Users</a>
            </div>
        }
        else
        {
            <div class="mt-4">
                <a asp-controller="UserPolls" asp-action="Index" class="btn btn-success btn-lg px-5 shadow">
                    🗳️ View Polls & Cast Your Vote
                </a>
            </div>
        }
    </div>
</div>
