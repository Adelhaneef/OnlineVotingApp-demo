@model OnlineVotingApp.Models.Poll

@{
    ViewData["Title"] = "Edit Poll";
}

<h2>Edit Poll</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="Question"></label>
        <input asp-for="Question" class="form-control" />
        <span asp-validation-for="Question" class="text-danger"></span>
    </div>

    <h4>Answer Options</h4>
    <div id="options-container">
        @for (int i = 0; i < Model.AnswerOptions.Count; i++)
        {
            <div class="option-item">
                <input type="hidden" name="AnswerOptions[@i].Id" value="@Model.AnswerOptions[i].Id" />
                <input type="text" name="AnswerOptions[@i].OptionText" value="@Model.AnswerOptions[i].OptionText" class="form-control mb-2" />
            </div>
        }
    </div>

    <br />
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>
